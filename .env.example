# Database (local Postgres container; see docker-compose.yml)
DATABASE_URL="postgresql://vigil:vigil_dev_password@localhost:5436/vigil_dev"

# PAPER is the only mode the runtime accepts from configuration. SHADOW and
# LIVE require the capability gate documented in docs/policy.md — setting
# VIGIL_MODE="LIVE" here does nothing but refuse to start.
VIGIL_MODE="PAPER"

LOG_LEVEL="info"

# Root for local market recordings and other gitignored data (Parquet/DuckDB).
DATA_ROOT="./data"

CONTROL_PORT="3300"

# Dashboard session secret; generate with `openssl rand -base64 32`. The auth
# provider itself is chosen with the dashboard slice (BOOT-07).
CONTROL_AUTH_SECRET=""

# Venue credentials, RPC endpoints, LLM provider keys, and signer material are
# added by their own gated slices as those slices land. Each is held only by
# the process that needs it — never by apps/control — and none of them are
# ever committed. The preflight hook refuses to stage a real .env file.
