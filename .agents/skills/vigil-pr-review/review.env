# Vigil PR review configuration.
#
# Every helper script in this skill sources this file (or the fixture named by
# $VIGIL_REVIEW_ENV, used only by tests/) instead of hardcoding repository or
# reviewer identity. A helper that needs VIGIL_REVIEW_REPO and finds it still
# a TODO(bootstrap) placeholder fails immediately with
# "not configured: set <VAR> in review.env" rather than guessing.
#
# VIGIL_REVIEWER_LOGIN is different: it is read only by review-status.sh, and
# an unset/placeholder value degrades that one helper's review classification
# to "unverified" with a clear message — it does not stop CI or thread checks,
# which do not depend on a reviewer identity.

VIGIL_REVIEW_OWNER=ceponatia

# "owner/name" of the GitHub repository whose PRs this skill inspects.
VIGIL_REVIEW_REPO=ceponatia/vigil

# Login of the designated reviewer (human or bot/app) whose review state
# review-status.sh classifies. Leave unset until one is designated.
VIGIL_REVIEWER_LOGIN="TODO(bootstrap): set VIGIL_REVIEWER_LOGIN once a reviewer identity is designated"
