# Vigil Development board configuration.
#
# Every helper script in this skill sources this file (or the fixture named by
# $VIGIL_BOARD_ENV, used only by tests/) instead of hardcoding board identity.
# A helper that needs a value still marked TODO(bootstrap) fails immediately
# with "not configured: set <VAR> in board.env" rather than guessing.
#
# Populate the TODO(bootstrap) values once the board exists; do not invent
# them. Owner and default assignee are already known.

VIGIL_BOARD_OWNER=ceponatia

# "owner/name" of the GitHub repository the board tracks.
VIGIL_BOARD_REPO=ceponatia/vigil

# GitHub Projects v2 board identity for "Vigil Development".
VIGIL_BOARD_NUMBER=8
VIGIL_BOARD_PROJECT_ID=PVT_kwHOARzdw84BjSzN

# Assignee used by the "assigned = the next action is the owner's" convention.
VIGIL_BOARD_ASSIGNEE=ceponatia
